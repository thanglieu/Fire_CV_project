DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LANGUAGE_CODE=vi
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh

# Gmail sender: use a Google App Password, not your normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=20
ALERT_EMAIL_SENDER=sender@gmail.com
ALERT_EMAIL_PASSWORD=replace-with-google-app-password
ALERT_EMAIL_RECEIVER=recipient@example.com

DROIDCAM_URL=http://192.168.1.101:4747/video
FIRE_MODEL_PATH=model_ai/best.pt
FIRE_DETECTION_CONFIDENCE=0.5
FIRE_DETECTION_IMAGE_SIZE=480
FIRE_ALERT_LABELS=fire,smoke
FIRE_ALERT_COOLDOWN_SECONDS=30
CAMERA_INFER_FPS=5
CAMERA_STREAM_FPS=30
CAMERA_JPEG_QUALITY=75
CAMERA_MAX_WIDTH=960
MEDIA_ROOT=media
APP_LOG_LEVEL=INFO
